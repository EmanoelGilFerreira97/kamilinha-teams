# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# Os dois valores abaixo sao publicos por natureza: eles vivem dentro do app
# instalado no celular. O que protege os dados e a Row Level Security no banco.
#
# A chave service_role NUNCA entra aqui: ela ignora toda a RLS.

EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-public-key
